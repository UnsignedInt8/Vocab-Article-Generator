# Claude API 配置（必填 ANTHROPIC_API_KEY）
ANTHROPIC_API_KEY=sk-ant-xxxxx
# 可选：自定义 endpoint（例如自建代理/网关），默认 https://api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com
# 可选：使用的模型，默认 claude-opus-5
CLAUDE_MODEL=claude-opus-5
# 可选：生成时的 effort 级别 (low|medium|high|xhigh|max)，默认 medium
CLAUDE_EFFORT=medium

# 可选：data.json 路径，默认 ./data.json
DATA_JSON_PATH=./data.json
# 可选：已使用单词记录文件路径，默认 ./used-words.json
USED_WORDS_DB_PATH=./used-words.json
# 可选：epub 输出目录，默认 ./epub
EPUB_OUTPUT_DIR=./epub
# 可选：音频输出目录，默认 ./mp3
AUDIO_OUTPUT_DIR=./mp3

# 可选：每篇文章使用的单词数，默认 30
BATCH_SIZE=30
# 可选：文章目标字数，默认 400
ARTICLE_WORD_COUNT=400
# 可选：audiblez 朗读音色，默认 af_heart
VOICE=af_heart
# 可选：audiblez 可执行文件路径/名称，默认 audiblez
AUDIBLEZ_BIN=audiblez
